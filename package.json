{
  "name": "aws-bill-explained",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp-hashes.mjs && node scripts/check-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run lint && astro check && vitest run && npm run build && npm run test:smoke && node scripts/check-freshness.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "lint": "prettier --check . && markdownlint-cli2",
    "deploy": "npm run check && wrangler pages deploy dist --project-name=aws-bill-explained",
    "preview:remote": "wrangler pages dev dist",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/open-sans": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.152.0"
  }
}
