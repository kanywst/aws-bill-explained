{
  "name": "aws-bill-explained",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp-hashes.mjs && node scripts/check-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run lint && astro check && vitest run && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "lint": "prettier --check . && markdownlint-cli2",
    "deploy": "npm run check && wrangler pages deploy dist --project-name=aws-bill-explained",
    "preview:remote": "wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/open-sans": "^5.3.0",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@vitest/coverage-v8": "^4.1.10",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
